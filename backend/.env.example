# Reuse the same MongoDB Atlas connection string used by the Telegram bot.
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<options>

# Keep the same database name as the bot.
MONGO_DB_NAME=demon_slayer_rpg

# Generate a long random secret. Do not reuse BOT_TOKEN.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: comma-separated frontend origins. Leave unset during local development.
WEB_ORIGINS=http://localhost:5173